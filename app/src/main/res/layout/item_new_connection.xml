<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="12dp"
    android:layout_margin="8dp">

    <!-- Same structure as item_complaint.xml: text area (left) +
         WhatsApp/Call/Drag icons (right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- TEXT AREA -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ncCustomerNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/ncAddressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address"
                android:textSize="16sp"
                android:textColor="#444444"
                android:layout_marginTop="3dp"/>

            <TextView
                android:id="@+id/ncPhoneText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03000000000"
                android:textSize="16sp"
                android:textColor="#444444"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/ncCommentsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comments"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"
                android:visibility="gone"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="──────────────"
                android:textSize="14sp"
                android:textColor="#BBBBBB"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- RIGHT SIDE ICONS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingBottom="26dp">

            <ImageView
                android:id="@+id/ncWhatsappButton"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="24dp"
                android:src="@drawable/ic_whatsapp"
                app:tint="#25D366"/>

            <ImageView
                android:id="@+id/ncCallButton"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="24dp"
                android:src="@drawable/ic_call"
                app:tint="#2196F3"/>

            <ImageView
                android:id="@+id/ncDragHandle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_sort_by_size"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Install button — kept below, since New Connection needs this
         action and Complaints' card doesn't have an equivalent here.
         Same card background carries through underneath it. -->
    <LinearLayout
        android:id="@+id/ncActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/ncInstallButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/button_green"
            android:text="Installed"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>