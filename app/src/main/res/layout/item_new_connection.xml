<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:orientation="vertical"
    android:background="@drawable/premium_card"
    android:elevation="3dp"
    android:padding="16dp">

    <TextView
        android:id="@+id/ncCustomerNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#111111"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="Customer Name" />

    <TextView
        android:id="@+id/ncAddressText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#444444"
        android:textSize="14sp"
        android:text="Address" />

    <TextView
        android:id="@+id/ncPhoneText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#444444"
        android:textSize="14sp"
        android:text="Phone" />

    <TextView
        android:id="@+id/ncCommentsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#777777"
        android:textSize="13sp"
        android:visibility="gone"
        android:text="Comments" />

    <LinearLayout
        android:id="@+id/ncActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/ncInstallButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/button_green"
            android:text="Installed"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
