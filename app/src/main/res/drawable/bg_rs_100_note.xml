<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The paper base (PKR 100 is reddish/pink) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8BBD0" />
            <stroke android:width="1dp" android:color="#AD1457" />
            <corners android:radius="1dp" />
        </shape>
    </item>

    <!-- Inner pattern for PKR 100 -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="#D81B60" android:dashWidth="2dp" android:dashGap="1dp" />
        </shape>
    </item>
</layer-list>